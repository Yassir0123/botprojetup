    def is_valid_url(self, url):
        try:
            result = urllib.parse.urlparse(url)
            return all([result.scheme, result.netloc])
        except ValueError:
            return False

    async def get_valid_card(self, cursor):
        while True:
            await cursor.execute("""
                SELECT c.*, cr.cardrank_name 
                FROM card c
                JOIN card_rank cr ON c.card_rank = cr.cardrank_id
                WHERE c.spawn_status = 1
            """)
            cards = await cursor.fetchall()

            rank_order = {'S': 0, 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5}
            sorted_cards = sorted(cards, key=lambda x: rank_order[x['cardrank_name']])

            rarity_percentages = {'S': 1, 'A': 2, 'B': 3, 'C': 6, 'D': 8, 'E': 80}

            total = sum(rarity_percentages.values())
            rand = random.randint(1, total)
            current_sum = 0
            selected_rank = None

            for rank, percentage in rarity_percentages.items():
                current_sum += percentage
                if rand <= current_sum:
                    selected_rank = rank
                    break

            possible_cards = [card for card in sorted_cards if card['cardrank_name'] == selected_rank]
            drawn_card = random.choice(possible_cards)

            if self.is_valid_url(drawn_card['image']):
                return drawn_card

    @commands.command()
    async def spawn(self, ctx):
        if not self.db_pool:
            await self.create_db_pool()

        if not self.db_pool:
            await ctx.send("Unable to connect to the database. Please try again later.")
            return

        try:
            async with self.db_pool.acquire() as conn:
                async with conn.cursor(aiomysql.DictCursor) as cursor:
                    # Get user information
                    await cursor.execute("SELECT user_id, quantiter_fragment, fragment_cap FROM user WHERE user_authorid = %s", (str(ctx.author.id),))
                    user_result = await cursor.fetchone()

                    if not user_result:
                        await ctx.send("Error: You need to register to the bot first.")
                        return

                    user_id = user_result['user_id']
                    current_fragments = user_result['quantiter_fragment']
                    fragment_cap = user_result['fragment_cap']

                    # Get a valid card
                    drawn_card = await self.get_valid_card(cursor)

                    # Check if user already has the card
                    await cursor.execute("SELECT * FROM user_cards WHERE user_id = %s AND card_id = %s", (user_id, drawn_card['card_id']))
                    user_card_result = await cursor.fetchone()

                    footer_text = ""
                    if not user_card_result:
                        # Add new card to user's collection
                        await cursor.execute("""
                            INSERT INTO user_cards (user_id, card_id, current_level, current_xp, 
                            current_mana, power_stat, attack_stat, health_stat, speed_stat) 
                            VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
                        """, (
                            user_id, drawn_card['card_id'], drawn_card['min_level'], 0, 0,
                            drawn_card['power'], drawn_card['attack'], drawn_card['health'], drawn_card['speed']
                        ))
                        title = f"🔥 New Card Unleashed: {drawn_card['card_name']}!"
                        description = "🎉 Congratulations! This card has been added to your collection!"
                    else:
                        if current_fragments >= fragment_cap:
                            title = f"Card Pulled: {drawn_card['card_name']}"
                            description = "You've reached your fragment limit!"
                            footer_text = "You have reached your fragments limits. Delete some if you wish to collect more!"
                        else:
                            # Handle fragment addition
                            await cursor.execute("SELECT id_fragment FROM fragments WHERE card_id = %s", (drawn_card['card_id'],))
                            fragment_result = await cursor.fetchone()

                            if fragment_result:
                                fragment_id = fragment_result['id_fragment']
                                await cursor.execute("SELECT inventory_id FROM inventory WHERE user_id = %s", (user_id,))
                                inventory_result = await cursor.fetchone()

                                if inventory_result:
                                    inventory_id = inventory_result['inventory_id']
                                    await cursor.execute("SELECT * FROM inventory_frags WHERE inventory_id = %s AND frag_id = %s", (inventory_id, fragment_id))
                                    inv_frag_result = await cursor.fetchone()

                                    if inv_frag_result:
                                        await cursor.execute("""
                                            UPDATE inventory_frags 
                                            SET quantiter = quantiter + 1 
                                            WHERE inventory_id = %s AND frag_id = %s
                                        """, (inventory_id, fragment_id))
                                    else:
                                        await cursor.execute("""
                                            INSERT INTO inventory_frags (inventory_id, frag_id, quantiter)
                                            VALUES (%s, %s, 1)
                                        """, (inventory_id, fragment_id))

                                    # Update total fragment count
                                    await cursor.execute("""
                                        SELECT SUM(quantiter) as total_fragments
                                        FROM inventory_frags
                                        WHERE inventory_id = %s
                                    """, (inventory_id,))
                                    total_fragments_result = await cursor.fetchone()
                                    total_fragments = total_fragments_result['total_fragments']

                                    if total_fragments <= fragment_cap:
                                        await cursor.execute("""
                                            UPDATE user
                                            SET quantiter_fragment = %s
                                            WHERE user_id = %s
                                        """, (total_fragments, user_id))

                                    title = f"Card Pulled: {drawn_card['card_name']}"
                                    description = "You already have this card."
                                    footer_text = f"You've received a fragment instead! Total fragments: {total_fragments}/{fragment_cap}"
                                else:
                                    title = f"Card Pulled: {drawn_card['card_name']}"
                                    description = "Error: Inventory not found."
                            else:
                                title = f"Card Pulled: {drawn_card['card_name']}"
                                description = "Error: Fragment not found for this card."

                    embed = discord.Embed(
                        title=title,
                        description=(
                            f"{description}\n\n"
                            f"*✨ Rank*: {drawn_card['cardrank_name']}\n"
                            f"*🔮 Type*: {drawn_card['type_card']}\n"
                            f"*🌟 Level*: {drawn_card['min_level']}\n"
                            f"*⚔️ Power*: {drawn_card['power']}\n"
                            f"*🛡️ Defense*: {drawn_card['health']}\n"
                            f"*💨 Speed*: {drawn_card['speed']}\n"
                        ),
                        color=discord.Color.blue()
                    )
                    embed.set_image(url=drawn_card['image'])
                    
                    if ctx.author.avatar:
                        embed.set_thumbnail(url=str(ctx.author.avatar.url))

                    if not footer_text:
                        sl_quotes = [
                            "The true hunter never rests.",
                            "Your strength defines your fate.",
                            "Another card, another step to greatness.",
                            "The shadows whisper, will you answer?"
                        ]
                        footer_text = random.choice(sl_quotes)

                    embed.set_footer(text=footer_text)
                    await ctx.send(embed=embed)

        except Exception as e:
            print(f"Error in spawn command: {e}")
            await ctx.send("An error occurred while processing your request. Please try again.")
